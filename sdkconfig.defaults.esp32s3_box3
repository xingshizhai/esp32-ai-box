# ESP32-S3-BOX-3 board-owned audio routing.
CONFIG_AUDIO_I2S_MCLK_GPIO=2
CONFIG_AUDIO_I2S_BCLK_GPIO=17
CONFIG_AUDIO_I2S_WS_GPIO=45
CONFIG_AUDIO_I2S_DOUT_GPIO=15
CONFIG_AUDIO_I2S_DIN_GPIO=16
CONFIG_AUDIO_CODEC_I2C_PORT=1
CONFIG_AUDIO_CODEC_I2C_SCL_GPIO=18
CONFIG_AUDIO_CODEC_I2C_SDA_GPIO=8
CONFIG_AUDIO_ES8311_I2C_ADDR=0x18
CONFIG_AUDIO_ES7210_I2C_ADDR=0x40
CONFIG_AUDIO_PA_GPIO=46
# CONFIG_AUDIO_PA_INVERTED is not set
